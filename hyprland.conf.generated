exec-once = /nix/store/zjslpcn77sh4qwm0jwv5xil8jwacckdi-dbus-1.16.2/bin/dbus-update-activation-environment --systemd DISPLAY HYPRLAND_INSTANCE_SIGNATURE WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE && systemctl --user stop hyprland-session.target && systemctl --user start hyprland-session.target
exec-shutdown = systemctl --user stop hyprland-session.target
$fileManager=dolphin
$mainMod=SUPER
$menu=rofi -show drun -config ~/.config/rofi/config.rasi
$terminal=ghostty
source=~/.config/hypr/monitors.conf
source=~/.cache/wallust/hyprland.conf
animations {
  bezier=myBezier, 0.05, 0.9, 0.1, 1.05
  animation=windows, 1, 7, myBezier
  animation=windowsOut, 1, 7, default, popin 80%
  animation=border, 1, 10, default
  animation=borderangle, 1, 8, default
  animation=fade, 1, 7, default
  animation=workspaces, 1, 6, default
  enabled=true
}

bind=$mainMod, T, exec, $terminal
bind=$mainMod, C, killactive,
bind=$mainMod, Q, killactive,
bind=$mainMod, M, exit,
bind=$mainMod, E, exec, $fileManager
bind=$mainMod, V, exec, ~/.config/hypr/scripts/ClipManager.sh
bind=$mainMod, R, exec, $menu
bind=ALT, Space, exec, $menu
bind=$mainMod, P, pseudo,
bind=$mainMod, backslash, layoutmsg, togglesplit,
bind=$mainMod, left, movefocus, l
bind=$mainMod, right, movefocus, r
bind=$mainMod, up, movefocus, u
bind=$mainMod, down, movefocus, d
bind=$mainMod, 1, workspace, 1
bind=$mainMod, 2, workspace, 2
bind=$mainMod, 3, workspace, 3
bind=$mainMod, 4, workspace, 4
bind=$mainMod, 5, workspace, 5
bind=$mainMod, 6, workspace, 6
bind=$mainMod, 7, workspace, 7
bind=$mainMod, 8, workspace, 8
bind=$mainMod, 9, workspace, 9
bind=$mainMod, 0, workspace, 10
bind=$mainMod SHIFT, 1, movetoworkspace, 1
bind=$mainMod SHIFT, 2, movetoworkspace, 2
bind=$mainMod SHIFT, 3, movetoworkspace, 3
bind=$mainMod SHIFT, 4, movetoworkspace, 4
bind=$mainMod SHIFT, 5, movetoworkspace, 5
bind=$mainMod SHIFT, 6, movetoworkspace, 6
bind=$mainMod SHIFT, 7, movetoworkspace, 7
bind=$mainMod SHIFT, 8, movetoworkspace, 8
bind=$mainMod SHIFT, 9, movetoworkspace, 9
bind=$mainMod SHIFT, 0, movetoworkspace, 10
bind=$mainMod, S, togglespecialworkspace, magic
bind=$mainMod SHIFT, G, movetoworkspace, special:magic
bind=$mainMod SHIFT, S, exec, spectacle -r -b -c -n
bind=$mainMod, mouse_down, workspace, e+1
bind=$mainMod, mouse_up, workspace, e-1
bind=CTRL ALT, T, exec, ghostty
bind=CTRL ALT, B, exec, zen-browser
bind=CTRL ALT, C, exec, zed
bind=CTRL ALT, O, exec, obsidian
bind=CTRL ALT, M, exec, WolframNB -platform xcb -singleLaunch
bind=CTRL SHIFT, Escape, exec, plasma-systemmonitor
bind=$mainMod, Escape, exec, plasma-systemmonitor
bind=$mainMod, H, movefocus, l
bind=$mainMod, J, movefocus, d
bind=$mainMod, K, movefocus, u
bind=$mainMod, L, exec, ~/.config/hypr/scripts/LockScreen.sh
bind=$mainMod SHIFT, Escape, exec, ~/.config/hypr/scripts/Wlogout.sh
bind=$mainMod, N, exec, swaync-client -t -sw
bind=$mainMod SHIFT, H, movewindow, l
bind=$mainMod SHIFT, J, movewindow, d
bind=$mainMod SHIFT, K, movewindow, u
bind=$mainMod SHIFT, L, movewindow, r
bind=ALT, F4, killactive,
bind=$mainMod, F, togglefloating,
bind=$mainMod, Prior, fullscreen, 1
bind=$mainMod, Next, movetoworkspacesilent, special:minimized
bind=$mainMod, Backspace, fullscreen, 0
bind=ALT, Tab, cyclenext,
bind=ALT SHIFT, Tab, cyclenext, prev
bind=$mainMod CTRL, right, workspace, e+1
bind=$mainMod CTRL, left, workspace, e-1
bind=$mainMod SHIFT, right, movewindow, mon:+1
bind=$mainMod SHIFT, left, movewindow, mon:-1

binde=$mainMod CTRL, H, resizeactive, -40 0
binde=$mainMod CTRL, J, resizeactive, 0 40
binde=$mainMod CTRL, K, resizeactive, 0 -40
binde=$mainMod CTRL, L, resizeactive, 40 0

bindl=, XF86AudioRaiseVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindl=, XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindl=SHIFT, XF86AudioRaiseVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+
bindl=SHIFT, XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-
bindl=, XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindl=, XF86AudioMicMute, exec, wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindl=$mainMod, XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindl=, XF86AudioPlay, exec, playerctl play-pause
bindl=, XF86AudioPause, exec, playerctl play-pause
bindl=, XF86AudioNext, exec, playerctl next
bindl=, XF86AudioPrev, exec, playerctl previous
bindl=, XF86AudioStop, exec, playerctl stop
bindl=, XF86MonBrightnessUp, exec, brightnessctl set +10%
bindl=, XF86MonBrightnessDown, exec, brightnessctl set 10%-
bindl=SHIFT, XF86MonBrightnessUp, exec, brightnessctl set +1%
bindl=SHIFT, XF86MonBrightnessDown, exec, brightnessctl set 1%-
bindl=, XF86KbdBrightnessUp, exec, brightnessctl -d *::kbd set +10%
bindl=, XF86KbdBrightnessDown, exec, brightnessctl -d *::kbd set 10%-

bindm=$mainMod, mouse:272, movewindow
bindm=$mainMod, mouse:273, resizewindow

decoration {
  blur {
    enabled=true
    passes=2
    size=6
    vibrancy=0.169600
  }
  active_opacity=0.750000
  inactive_opacity=0.750000
  rounding=15
}

device {
  name=epic-mouse-v1
  sensitivity=-0.500000
}

dwindle {
  preserve_split=true
}

env=XDG_CURRENT_DESKTOP,Hyprland
env=XDG_SESSION_DESKTOP,Hyprland
env=XDG_SESSION_TYPE,wayland
env=XCURSOR_SIZE,18
env=HYPRCURSOR_SIZE,18

exec-once=dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE
exec-once=systemctl --user start plasma-kwallet-pam.service plasma-kded6.service
exec-once=qdbus6 org.kde.kwalletd6 /modules/kwalletd6 org.kde.KWallet.open kdewallet 0 login
exec-once=ksecretd
exec-once=/nix/store/0psp8qrqlnfsz3546jbpqxk9jdwrq3ah-polkit-kde-agent-1-6.7.5/libexec/polkit-kde-authentication-agent-1
exec-once=nm-applet --indicator
exec-once=swaync
exec-once=waybar & hyprpaper & firefox
exec-once=wl-paste --type text --watch cliphist store
exec-once=wl-paste --type image --watch cliphist store

general {
  allow_tearing=false
  border_size=2
  col.active_border=$active_border_color
  col.inactive_border=$inactive_border_color
  gaps_in=3
  gaps_out=10
  layout=dwindle
  resize_on_border=false
}

input {
  touchpad {
    natural_scroll=false
  }
  follow_mouse=0
  kb_layout=us
  sensitivity=0
}

master {
  new_status=master
}

misc {
  disable_hyprland_logo=false
  force_default_wallpaper=0
}

windowrule {
  name=Youtube
  match:title=.*- YouTube.*
  opacity=1.0 override 1.0 override
}

windowrule {
  name=Youtube-Watch
  match:title=.*\| Watch \|.*
  opacity=1.0 override 1.0 override
}

windowrule {
  name=PnP
  match:title=Picture-in-Picture
}

windowrule {
  name=Floating Windows
  float=true
  match:class=^(zoom|RocketChat)$
}
monitor=,preferred,auto,auto
