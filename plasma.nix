    enable = true;

    # ---------------------------------------------------------------
    # Theme stack.
    #
    # rc2nix omits these on purpose: ColorScheme, Theme and
    # LookAndFeelPackage are on its KEY_BLOCK_LIST, because
    # plasma-manager wants them set through these typed options, which
    # also invoke the matching plasma-apply-* tool. Values below are
    # what was live on the old machine.
    #
    # Each needs its package present or Plasma silently falls back to
    # Breeze:
    #   colorScheme KlassyDark   <- klassy
    #   widgetStyle Darkly       <- darkly (verify it is in nixpkgs)
    #   theme       darkly       <- darkly plasma theme
    #   iconTheme   YAMIS        <- not packaged; copy the icon dir
    #   cursor      BreezeX-Dark <- breeze-x cursor package
    # ---------------------------------------------------------------
    workspace = {
      colorScheme = "KlassyDark";
      widgetStyle = "Darkly";
      theme = "darkly";
      iconTheme = "YAMIS";
      lookAndFeel = "org.kde.breezedark.desktop";
      cursor.theme = "BreezeX-Dark";
    };

