[
{
  "output": ["!DP-1", "!DVI-I-1", "*"],
  "layer": "top",
  "position": "top",
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "height": 34,
  "spacing": 0,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": ["pulseaudio", "network", "bluetooth", "cpu", "memory", "battery", "clock", "tray"],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "active-only": false,
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "active": "●",
      "default": "○",
    },
  },
  "hyprland/window": {
    "format": "    {}",
    "max-length": 80,
    "min-length": 30,
    "separate-outputs": true,
  },
  "clock": {
    "format": "  {:%H:%M     %a %d %b}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "on-click": "evolution -c calendar &",
  },
  "cpu": {
    "format": "  {usage}%",
    "interval": 2,
  },
  "memory": {
    "format": "  {}%",
    "interval": 2,
  },
  "network": {
    "interface": "wlp2s0",
    "format-wifi": "  {essid} {signalStrength}%",
    "format-ethernet": "󰈀  {ipaddr}",
    "format-linked": "󰈀  Linked",
    "format-disconnected": "󰤮  Offline",
    "format-disabled": "󰤭  Disabled",
    "tooltip-format-wifi": "{essid}\n{ifname} via {gwaddr}\nSignal: {signalStrength}%",
    "tooltip-format-ethernet": "{ifname} via {gwaddr}\n{ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Network disconnected",
    "on-click": "~/.config/waybar/scripts/network-menu",
    "on-click-right": "nm-connection-editor",
    "on-click-middle": "plasmawindowed org.kde.plasma.networkmanagement",
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "  Muted",
    "format-icons": {
      "default": [" ", " ", " "],
    },
    "on-click": "pavucontrol",
  },
  "bluetooth": {
    "format": " {status}",
    "format-connected": " {device_alias}",
    "format-disabled": " Off",
    "on-click": "blueman-manager",
    "tooltip-format": "{controller_alias}  {controller_address}",
    "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}  {device_address}",
  },
  "battery": {
    "bat": "BAT0",
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "{icon}   {capacity}%",
    "format-plugged": "{icon}   {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{timeTo} — {power:.1f}W",
  },
  "tray": {
    "icon-size": 15,
    "spacing": 10,
  },
},
{
  "output": ["DP-1", "DVI-I-1"],
  "name": "vertical",
  "layer": "top",
  "position": "top",
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "height": 34,
  "spacing": 0,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": [],
  "modules-right": ["pulseaudio", "network", "battery", "clock", "tray"],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "active-only": false,
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "active": "●",
      "default": "○",
    },
  },
  "clock": {
    "format": "  {:%H:%M     %a %d %b}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "on-click": "evolution -c calendar &",
  },
  "network": {
    "interface": "wlp2s0",
    "format-wifi": "  {essid} {signalStrength}%",
    "format-ethernet": "󰈀  {ipaddr}",
    "format-linked": "󰈀  Linked",
    "format-disconnected": "󰤮  Offline",
    "format-disabled": "󰤭  Disabled",
    "tooltip-format-wifi": "{essid}\n{ifname} via {gwaddr}\nSignal: {signalStrength}%",
    "tooltip-format-ethernet": "{ifname} via {gwaddr}\n{ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Network disconnected",
    "on-click": "~/.config/waybar/scripts/network-menu",
    "on-click-right": "nm-connection-editor",
    "on-click-middle": "plasmawindowed org.kde.plasma.networkmanagement",
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "  Muted",
    "format-icons": {
      "default": [" ", " ", " "],
    },
    "on-click": "pavucontrol",
  },
  "battery": {
    "bat": "BAT0",
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "{icon}   {capacity}%",
    "format-plugged": "{icon}   {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{timeTo} — {power:.1f}W",
  },
  "tray": {
    "icon-size": 15,
    "spacing": 10,
  },
}
]
